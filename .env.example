# Copy to .env (gitignored) and fill in for a real chain. Not needed on local anvil.
# Arc mainnet (chain 5042). Testnet (chain 5042002): https://rpc.testnet.arc.io
RPC_URL=https://rpc.mainnet.arc.io
# Deploys Semaphore (setup_chain.py) and command-line elections. Needs gas money.
DEPLOYER_KEY=0x273d7eb05D1f7760F01360c91F87f54a2c34383d
# Pays gas for relayed registrations and votes; reimbursed by each election.
RELAYER_KEY=0x...

# Same relayer wallet on mainnet and testnet: put RELAYER_KEY alone in relayer.env
# (gitignored). Every network reads it from there, and `python relayer.py mainnet testnet`
# runs both relayers. A RELAYER_KEY in .env or .env.testnet overrides it for that network.

# A second deployment (the site's /testnet page): put RPC_URL and DEPLOYER_KEY, with the
# testnet RPC and a testnet-funded key, in .env.testnet and run the scripts with
# GOBLETT_NETWORK=testnet. They then use election.testnet.json and read nothing from this file.
